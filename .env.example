# Copie este arquivo para .env e substitua todos os placeholders antes de usar.
# Mantenha official em produção. Para usar FakeGov localmente, substitua a linha
# do provider e mantenha as configurações compartilhadas do consumidor.
# O launcher lê este `.env` no diretório atual. Variáveis exportadas pelo
# terminal têm precedência; objetos de configuração passados pela aplicação
# têm precedência sobre ambas as fontes. Variáveis GOVBR_* desconhecidas geram
# erro, e variáveis reconhecidas mas inativas para o provider geram warning.
# No perfil fake, a demonstração local fica disponível em /govbr-auth-demo.
GOVBR_PROVIDER=official
# GOVBR_PROVIDER=fake
# Configuração compartilhada do consumidor.
# GOVBR_REDIRECT_URI é usada pelo adapter e registrada no provedor selecionado.
GOVBR_ENVIRONMENT=production
GOVBR_CLIENT_ID=seu-client-id
GOVBR_CLIENT_SECRET=seu-client-secret
GOVBR_REDIRECT_URI=https://app.example/auth/govbr/callback
GOVBR_SCOPE=openid profile email
GOVBR_LOGOUT_URL=https://sso.acesso.gov.br/logout
GOVBR_POST_LOGOUT_REDIRECT_URI=https://app.example/auth/signed-out
# Gere uma vez: from govbr_auth import generate_transaction_secret; print(generate_transaction_secret())
# O state é um envelope Fernet stateless; não exige storage compartilhado.
# Mantenha o valor secreto e use o mesmo valor em todas as instâncias e workers do deployment.
GOVBR_TRANSACTION_SECRET=substitua-pelo-valor-gerado
GOVBR_CONNECT_TIMEOUT_SECONDS=5
GOVBR_READ_TIMEOUT_SECONDS=10
GOVBR_CLOCK_SKEW_SECONDS=60

# Configuração exclusiva dos endpoints oficiais Gov.br. Não a defina quando
# GOVBR_PROVIDER=fake.
GOVBR_AUTHORIZATION_URL=https://sso.acesso.gov.br/authorize
GOVBR_TOKEN_URL=https://sso.acesso.gov.br/token
GOVBR_USERINFO_URL=https://sso.acesso.gov.br/userinfo/
GOVBR_ISSUER=https://sso.acesso.gov.br/
GOVBR_JWKS_URL=https://sso.acesso.gov.br/jwk

# Configuração local FakeGov. Estes valores nunca autorizam credenciais reais.
# Nos adapters, o provider fake é incorporado à aplicação consumidora.
# O launcher `python -m govbr_auth.fake` usa loopback.
# O FakeGov reutiliza GOVBR_CLIENT_ID, GOVBR_CLIENT_SECRET e GOVBR_REDIRECT_URI.
# GOVBR_FAKE_HOST=127.0.0.1
# GOVBR_FAKE_PORT=8000
# GOVBR_FAKE_PROVIDER_PREFIX=/fake-govbr
# GOVBR_FAKE_REQUEST_TTL_SECONDS=300
# GOVBR_FAKE_AUTHORIZATION_CODE_TTL_SECONDS=60
# GOVBR_FAKE_ACCESS_TOKEN_TTL_SECONDS=600
# GOVBR_FAKE_ID_TOKEN_TTL_SECONDS=300
# GOVBR_FAKE_USERS_FILE=./fake-users.local.json
